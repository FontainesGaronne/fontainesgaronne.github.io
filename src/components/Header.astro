---
// import HeaderLink from "./HeaderLink.astro";
import client from "../../tina/__generated__/client";
import { tinaField } from "tinacms/dist/react";
import SubMenu from "./react/submenu";
import HeaderLink from "./react/headerlink";
import { getHrefFromRelativePath, getRelativeUrl, removeEndSlash } from "./react/utils";

const { data } = await client.queries.global({
	relativePath: "index.json",
});
const header = data.global.header;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
---

<header class="relative bg-white shadow-xs z-10">
	<div class="mx-auto px-6 max-w-8xl">
		<div class="flex items-center justify-between flex-wrap gap-6">
			<p class="text-lg font-bold tracking-tight xs:my-4">
				<a href="/" class="flex gap-2 items-center tracking-[.002em]">
					<span data-tina-field={tinaField(header, "name")}>
						<img
							src="/logo.png"
							alt=""
							width={80}
							height={80}
						/>
					</span>
					<span data-tina-field={tinaField(header, "name")}>
						{header?.name}
					</span>
					<span class="sr-only">Retour à la page d'accueil</span>
				</a>
			</p>	
			{header?.nav && (
				<nav role="navigation">
						<ul class="flex flex-wrap gap-x-6 sm:gap-x-8 lg:gap-x-10 tracking-[.002em] -mx-4">
							{header.nav.filter(link => link !== null).map((link) => {
									const submenu = link?.submenu?.map(item => ({ ...item, href: getHrefFromRelativePath(item?.submenuItem?._sys.relativePath) }))
									return (
										<li class="relative flex items-center">
											{!link.submenu ? (
												<HeaderLink
													href={getRelativeUrl(link.href)}
													data-actif={getRelativeUrl(removeEndSlash(pathname)) === getRelativeUrl(link.href)}
												>
													{link.label}
												</HeaderLink>
											) : (
												<SubMenu list={submenu} pathname={removeEndSlash(pathname)} client:load>
													<HeaderLink
														href={getRelativeUrl(link.href)}
														data-actif={(getRelativeUrl(removeEndSlash(pathname)) === getRelativeUrl(link.href) || (submenu?.some(item => getRelativeUrl(item.href) === getRelativeUrl(removeEndSlash(pathname))))) ?? false}
													>
														{link.label}
													</HeaderLink>
												</SubMenu>
											)}
										</li>
									);
								})
							}
						</ul>
				</nav>
			)}
			</div>
	</div>
</header>
