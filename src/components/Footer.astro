---
import { Facebook, Instagram, Mail, Mails, Rss } from "lucide-react";
import Map from '../components/Map.astro';


---

<footer role="contentinfo" class="bg-white shadow-sm">
	<div class="flex flex-wrap items-center justify-between mx-auto px-6 max-w-7xl">
			<a
				href="/"
				class="group mx-2 font-bold tracking-tight text-gray-400 opacity-80 hover:opacity-100 transition duration-150 ease-out whitespace-nowrap"
			>
				<img
				  loading="lazy"
					src="/logo-cqfg.png"
					alt="Comité de quartier Fontaines Garonne - Toulouse"
					width={196}
					height={80}
				/>
					<span class="sr-only">Retour à l'accueil</span>
			</a>
			<div class="flex items-center gap-2 text-lg">
				<span class="font-medium">Suivez-nous :</span>
				<ul class="flex items-center gap-2">
					<li>
						<a href="https://www.facebook.com/people/Comit%C3%A9-de-quartier-Fontaines-Garonne/100064331366255/" target="_blank">
							<Facebook size={18} aria-hidden />
							<span class="sr-only">sur Facebook</span>
						</a>
					</li>
					<li role="presentation">-</li>
					<li>
						<a href="https://www.instagram.com/comitequartierfontainesgaronne/" target="_blank">
							<Instagram size={18} aria-hidden />
							<span class="sr-only">sur Instagram</span>
						</a>
					</li>
				</ul>
			</div>
			<div class="flex flex-col gap-2 my-4">
				<ul class="flex text-lg flex-col gap-2">
					<li>
						<a class="flex gap-2 items-center hover:underline" href="/newsletter">
							<Mails size={18} aria-hidden />
							Abonnez-vous à notre newsletter
						</a>
					</li>
					<li>
						<a href="mailto:fontaines.garonne@free.fr" class="flex gap-2 items-center hover:underline">
							<Mail size={16} aria-hidden />
							Contactez-nous
						</a>
					</li>
					<li>
						<a class="flex gap-2 items-center hover:underline" href="/rss.xml">
							<Rss size={18} aria-hidden />
							S'abonner au flux RSS des actualités <span class="sr-only">du quartier</span>
						</a>
					</li>
				</ul>
			</div>
		</div>
	<Map />
</footer>
