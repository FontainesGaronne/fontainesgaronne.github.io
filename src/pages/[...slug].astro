---
import { getCollection } from "astro:content";
import client from "../../tina/__generated__/client";
import Page from "../../tina/pages/Page";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import BaseHead from "../components/BaseHead.astro";
import config from '../content/config/config.json';

export async function getStaticPaths() {
	const page = await getCollection("page");
	return page.map((p) => ({
		params: { slug: p.id },
		props: {
			getTinaProps: async () =>
				client.queries.page({
					relativePath: p.data.tinaInfo.relativePath,
				}),
		},
	}));
}

const { getTinaProps } = Astro.props;
const global = await client.queries.global({
	relativePath: "index.json",
});
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const nav = global.data.global.header?.nav;
const data = await getTinaProps();
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={data.data.page.title} description={config.seo.description} />
	</head>
	<body class="min-h-dvh font-sans text-gray-800 bg-gray-50 flex flex-col">
		<Header />
			<Page {...data} nav={nav} pathname={pathname} client:tina />
		<Footer />
	</body>
</html>

